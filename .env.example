# ============================================================
# B2B Lead Generation Pipeline – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----------------------------------------------------------
# 1. GROQ (FREE AI - REQUIRED)
#    Sign up: https://console.groq.com
#    Free tier: ~14,400 requests/day (llama-3.3-70b-versatile)
# ----------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------
# 2. EMAIL SENDER (REQUIRED)
#    Choose ONE provider below and set EMAIL_PROVIDER accordingly
# ----------------------------------------------------------
SENDER_EMAIL=you@gmail.com
SENDER_NAME=Your Name
EMAIL_PROVIDER=gmail        # Options: gmail | brevo | resend

# Option A: Gmail (500 emails/day free)
# Get App Password: myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on your Google account)
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# Option B: Brevo – formerly Sendinblue (300 emails/day FREE)
# Sign up: https://www.brevo.com → SMTP & API → SMTP keys
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=

# Option C: Resend (100 emails/day, 3000/month FREE)
# Sign up: https://resend.com → API Keys
RESEND_API_KEY=

# ----------------------------------------------------------
# 3. LEAD FINDING (OPTIONAL – DuckDuckGo is used by default, no key needed)
# ----------------------------------------------------------

# Google Custom Search (100 free queries/day – optional upgrade)
# Step 1: Create API key: https://console.developers.google.com → Custom Search JSON API
# Step 2: Create search engine: https://cse.google.com
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Hunter.io – finds professional emails (25 free/month)
# Sign up: https://hunter.io
HUNTER_API_KEY=

# ----------------------------------------------------------
# 4. PIPELINE SETTINGS
# ----------------------------------------------------------
DAILY_TARGET=10             # Number of emails to send per run (start with 10)
MIN_FIT_SCORE=60            # Minimum fit score to proceed with outreach (0-100)
DELAY_BETWEEN_EMAILS=30     # Seconds to wait between emails (avoid spam filters)
SCRAPE_DELAY=2.0            # Seconds between website scrape requests

# Follow-up sequence (days to wait before each follow-up)
# Follow-up 1: after 3 days  | Follow-up 2: after 7 days | Follow-up 3: after 14 days
# These are hardcoded in agents/follow_up_agent.py – edit FOLLOW_UP_SEQUENCE to change

# ----------------------------------------------------------
# 5. DATABASE
# ----------------------------------------------------------
# /tmp/leads.db  — default, works on Render free tier and GitHub Actions
# data/leads.db  — use this for local development (persists between runs)
DATABASE_PATH=/tmp/leads.db

# ----------------------------------------------------------
# 6. DASHBOARD
# ----------------------------------------------------------
DASHBOARD_SECRET_KEY=change-this-to-a-random-string
PORT=5000
